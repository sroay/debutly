# Bring your own key. An OpenRouter key (https://openrouter.ai/keys) is all a run needs: Debutly
# picks the provider and models from it. An Anthropic key (sk-ant-…) works too.
DEBUTLY_API_KEY=

# Optional: record runs for the dashboard (any Postgres; Neon and Supabase have free plans).
# DEBUTLY_STORE_URL=

# Optional overrides. With an OpenRouter key these default to:
# DEBUTLY_PROVIDER=openai-compatible
# DEBUTLY_BASE_URL=https://openrouter.ai/api/v1
# The agents' model. GLM-5.3 Flash matched Gemini 3.8 Flash on 2026-09-29 at about a quarter of
# the cost per run, taking ~40% more steps. google/gemini-3.8-flash is faster; see README "Models".
# DEBUTLY_NAV_MODEL=z-ai/glm-5.3-flash
# Writes the personas and judges pages.
# DEBUTLY_JUDGE_MODEL=deepseek/deepseek-v4-flash
# low | medium | high (OpenRouter reasoning control for the agents' model)
# DEBUTLY_REASONING_EFFORT=low
# OpenRouter provider routing as JSON, e.g. {"order":["google-ai-studio/flex"]} for Gemini at half price
# DEBUTLY_NAV_ROUTING=
