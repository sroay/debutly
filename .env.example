# Bring your own key. Provider: openai-compatible (OpenRouter, DeepSeek, ...) | anthropic
DEBUTLY_PROVIDER=openai-compatible
DEBUTLY_BASE_URL=https://openrouter.ai/api/v1
DEBUTLY_API_KEY=

# The agents' model. GLM-5.3 Flash matched Gemini 3.8 Flash on 2026-09-29 at about a quarter of the cost per run
# (give it ~40% more --max-steps). google/gemini-3.8-flash is faster; see README "Models".
DEBUTLY_NAV_MODEL=z-ai/glm-5.3-flash
# Optional: OpenRouter provider routing as JSON, e.g. {"order":["google-ai-studio/flex"]} for Gemini at half price
# DEBUTLY_NAV_ROUTING=
# Writes the personas once per run
DEBUTLY_JUDGE_MODEL=deepseek/deepseek-v4-flash
# Optional: low | medium | high (OpenRouter reasoning control for the navigation model)
DEBUTLY_REASONING_EFFORT=low
